# /etc/cron.d/omnai
# Fallback host-level cron que dispara tasks via agents-api caso o n8n esteja indisponivel.
# Timezone do VPS deve estar em Europe/Lisbon (o bootstrap.sh nao altera TZ, verificar com `timedatectl`).
# Instalar: sudo cp schedules/crontab.omnai /etc/cron.d/omnai && sudo chmod 644 /etc/cron.d/omnai

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Helper: curl POST para o endpoint interno do agents-api
# (assume Caddy a expor agents.omnai.pt; usa Basic Auth se adicionares)

# email-scan                         - Seg-Sex 07:54
45 7  * * 1-5  omnai curl -fsS -X POST http://localhost/tasks/run/email-scan -H "Host: agents.omnai.pt" >> /var/log/omnai-cron.log 2>&1

# briefing-carlos                    - Seg-Sex 08:18
15 8  * * 1-5  omnai curl -fsS -X POST http://localhost/tasks/run/briefing-carlos -H "Host: agents.omnai.pt" >> /var/log/omnai-cron.log 2>&1

# scan-concursos-publicos            - Seg-Sex 10:08
