# =============================================================
# OMNAI Stack - ficheiro de ambiente
# Copia para .env e preenche todos os valores.
# NUNCA faças commit do .env (esta no .gitignore).
# =============================================================

# ---- Postgres (interno, nao exposto fora do Docker) ----
POSTGRES_USER=omnai
POSTGRES_PASSWORD=CHANGE_ME_gerar_com_openssl_rand_base64_24
POSTGRES_DB=omnai

# ---- Redis (interno, nao exposto) ----
REDIS_PASSWORD=CHANGE_ME_gerar_com_openssl_rand_base64_24

# ---- Auth do agents-api ----
# Header X-OMNAI-Token que o n8n envia em cada POST. Gera com: openssl rand -hex 32
OMNAI_API_TOKEN=CHANGE_ME_hex_64_chars

# ---- Anthropic (Claude) ----
# Chave real da console.anthropic.com/settings/keys. Comeca por sk-ant-api03-
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Notion ----
# Internal Integration Secret. Comeca por ntn_
# Conectar a integracao a pagina OMNAI Command Center no Notion (••• > Conexoes)
NOTION_TOKEN=ntn_...
NOTION_VERSION=2022-06-28

# ---- (Opcional) outras chaves que possas adicionar no futuro ----
# OPENAI_API_KEY=
# GITHUB_TOKEN=
